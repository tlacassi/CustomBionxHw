(version 1)

# Audit point 8 : isolement entre le domaine BMS (masse B-) et la carte (masse P-)
(rule "Isolement BMS"
	(constraint clearance (min 0.5mm))
	(condition "A.NetClass == 'BMS' && B.NetClass != 'BMS'"))

# Audit point 15 : isolement entre les nets au potentiel du pack (42 V) et la basse tension
(rule "Isolement HV"
	(constraint clearance (min 0.3mm))
	(condition "(A.NetName == 'PACK_RAW' || A.NetName == 'PACK_SW' || A.NetName == 'SENSE' || A.NetName == 'SHUNT_KP' || A.NetName == 'SHUNT_KN' || A.NetName == 'Net-(J8-*' || A.NetName == 'Net-(J11-*' || A.NetName == 'Net-(Q3-D)' || A.NetName == '*FET_SRC' || A.NetName == '*MAIN_GATE' || A.NetName == '*/Q1_G' || A.NetName == '*PRE_GATE' || A.NetName == '*VS_FILTERED' || A.NetName == '*ISCP' || A.NetName == '/01  Commutation et précharge/BST' || A.NetName == 'Net-(U1-CS+)' || A.NetName == 'Net-(U1-PU)') && !(B.NetName == 'PACK_RAW' || B.NetName == 'PACK_SW' || B.NetName == 'SENSE' || B.NetName == 'SHUNT_KP' || B.NetName == 'SHUNT_KN' || B.NetName == 'Net-(J8-*' || B.NetName == 'Net-(J11-*' || B.NetName == 'Net-(Q3-D)' || B.NetName == '*FET_SRC' || B.NetName == '*MAIN_GATE' || B.NetName == '*/Q1_G' || B.NetName == '*PRE_GATE' || B.NetName == '*VS_FILTERED' || B.NetName == '*ISCP' || B.NetName == '/01  Commutation et précharge/BST' || B.NetName == 'Net-(U1-CS+)' || B.NetName == 'Net-(U1-PU)') && B.NetClass != 'BMS'"))
