	(text "Pack: 10S; 30 A fuse reported. 42 V maximum applies only if the cells are standard 4.2 V/cell Li-ion." (exclude_from_sim no) (at 40 45 0) (effects (font (size 1.15 1.15)) (justify left bottom)) (uuid "87ebdf1e-97cb-481c-8b79-4e8336858985"))
	(text "U1 LM5069MM-1 is an 80 V hot-swap/inrush controller with latch-off; JLCPCB C3177598 (extended listing)." (exclude_from_sim no) (at 40 52 0) (effects (font (size 1.15 1.15)) (justify left bottom)) (uuid "4033b672-db19-41e9-b135-8d40311685c4"))
	(text "Q1, sense resistor, current/power limits, timers, UVLO/OVLO and thermal path are intentionally TBD." (exclude_from_sim no) (at 40 59 0) (effects (font (size 1.15 1.15)) (justify left bottom)) (uuid "455ad210-e022-4583-afb5-b4d76733a7d4"))
	(text "Precharge/inrush here is through controlled Q1 turn-on. A separate resistor/relay path needs controller input capacitance and desired precharge time." (exclude_from_sim no) (at 40 66 0) (effects (font (size 1.15 1.15)) (justify left bottom)) (uuid "cab0c951-d3df-40fa-9bd4-4523b8f4c542"))
	(text "Do not connect this starter to a pack or motor controller. High-current path, fuse coordination, reverse polarity, transient clamp and thermal validation remain open." (exclude_from_sim no) (at 40 73 0) (effects (font (size 1.15 1.15)) (justify left bottom)) (uuid "1a195997-f9af-4b21-bd28-fa5757f32850"))
